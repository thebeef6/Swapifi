    <string name="help_title">Set up Swapifi</string>
    <string name="help_intro">To make Swapifi work correctly, follow these steps:</string>
    <string name="help_step1">1. Grant the music and audio permission and the notification permission when prompted</string>
    <string name="help_step2">2. Disable battery optimization for Swapifi in your system settings</string>
    <string name="help_step3">3. Keep Swapifi running in the background while using Spotify</string>
    <string name="help_step4">4. To change your local music folder, tap the folder name shown above the song list</string>
