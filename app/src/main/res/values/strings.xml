    <string name="how_title">How Swapifi works</string>
    <string name="how_point1">• When Spotify plays an ad, Swapifi mutes it and plays your local music</string>
    <string name="how_point2">• When the ad ends, Spotify comes back automatically</string>
    <string name="how_point3">• While your local music is playing, adjust its volume with the phone\'s alarm volume</string>

